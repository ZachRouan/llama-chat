# llama-chat configuration
# See README.md for details

# Comma-separated list of llama.cpp servers (host:port or host:port:context_length)
LLAMA_SERVERS=localhost:8082,localhost:8081

# System prompt
LLAMA_SYSTEM_PROMPT=You are a helpful assistant.

# Max tokens per response
LLAMA_MAX_TOKENS=2048

# Sampling temperature (0.0 - 2.0)
LLAMA_TEMPERATURE=0.7

# Fallback context window size (used when per-server and auto-detection unavailable)
LLAMA_CONTEXT_LENGTH=4096
